# The one file to edit. Then run ./build.sh to make the USB image.

CLUSTER_NAME=croods
SUBNET_PREFIX=10.0.0
NETMASK_BITS=24
TIMEZONE=Etc/UTC

# hostname  ip  role  [extra Slurm settings for odd hardware]
# role: head (runs Slurm + shared files), backup (nightly copy of /home), compute
# Named after The Croods: Grug leads the family, Gran remembers everything, the rest do the work.
NODES="
grug   10.0.0.1   head
gran   10.0.0.11  backup
eep    10.0.0.21  compute
ugga   10.0.0.22  compute
thunk  10.0.0.23  compute  RealMemory=11500
guy    10.0.0.24  compute  CPUs=20 CoresPerSocket=20 ThreadsPerCore=1
"

# Hybrid Intel CPUs (12th gen+): Slurm miscounts their threads, so don't pin jobs to cores there.
NO_CORE_PINNING="guy"

# Admin account on every machine (same UID everywhere, so shared files keep the right owner)
ADMIN_USER=hpcadmin
ADMIN_UID=2000

# Service accounts must match across machines. Avoid 9xx: Ubuntu uses those itself.
MUNGE_UID=450
SLURM_UID=451

# Default compute node shape (check with: slurmd -C). RealMemory in MiB, ~1 GB spare.
NODE_SOCKETS=1
NODE_CORES=4
NODE_THREADS=2
NODE_REALMEM=14800
DEF_MEM_PER_CPU=1800

# Packages copied into the offline repo on the USB
COMMON_PKGS="chrony nfs-common rsync htop vim tmux pdsh curl ethtool smartmontools"
HEAD_PKGS="slurmctld slurm-client munge nfs-kernel-server openmpi-bin libopenmpi-dev build-essential gfortran python3-venv python3-pip restic zip"
COMPUTE_PKGS="slurmd slurm-client munge openmpi-bin libopenmpi-dev build-essential gfortran python3-venv"
BACKUP_PKGS="restic"
