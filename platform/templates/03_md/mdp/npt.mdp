; 100 ps, restrained, pressure 1 bar
integrator           = md
nsteps               = 50000
define               = -DPOSRES
continuation         = yes
refcoord_scaling     = com
dt                   = 0.002
constraints          = h-bonds
constraint_algorithm = lincs
cutoff-scheme        = Verlet
coulombtype          = PME
rcoulomb             = 1.0
rvdw                 = 1.0
DispCorr             = EnerPres
tcoupl               = V-rescale
tc-grps              = Protein Non-Protein
tau_t                = 0.1 0.1
ref_t                = @TEMP@ @TEMP@
pbc                  = xyz
nstenergy            = 5000
nstlog               = 5000
pcoupl               = C-rescale
tau_p                = 2.0
ref_p                = 1.0
compressibility      = 4.5e-5
