; production, frame every 100 ps
integrator           = md
nsteps               = @NSTEPS@
continuation         = yes
nstxout-compressed   = 50000
dt                   = 0.002
constraints          = h-bonds
constraint_algorithm = lincs
cutoff-scheme        = Verlet
coulombtype          = PME
rcoulomb             = 1.0
rvdw                 = 1.0
DispCorr             = EnerPres
tcoupl               = V-rescale
tc-grps              = Protein Non-Protein
tau_t                = 0.1 0.1
ref_t                = @TEMP@ @TEMP@
pbc                  = xyz
nstenergy            = 5000
nstlog               = 5000
pcoupl               = C-rescale
tau_p                = 2.0
ref_p                = 1.0
compressibility      = 4.5e-5
