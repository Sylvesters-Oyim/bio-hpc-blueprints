# slurmctld.service -- generated by Ansible from slurmctld.service.j2.
# NOTE: added during repo assembly — referenced by the slurm role but not previously
# present. Standard systemd unit for a source-built Slurm; review before production.
# Author: Sylvesters Ochieng Oyim, Rhodes University
[Unit]
Description=BioLab Slurm controller daemon (slurmctld)
After=network-online.target munge.service
Wants=network-online.target
Requires=munge.service

[Service]
Type=simple
User={{ slurm_user }}
Group={{ slurm_user }}
ExecStart={{ slurm_prefix }}/sbin/slurmctld -D -s
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=131072
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
