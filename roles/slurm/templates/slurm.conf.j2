# slurm.conf  --  generated by Ansible. Do not hand-edit; change the template + rerun.
# Author: Sylvesters Ochieng Oyim, Rhodes University
ClusterName={{ cluster_name }}
SlurmctldHost={{ control_machine }}({{ hostvars[control_machine].node_addr }})

SlurmUser={{ slurm_user }}
StateSaveLocation=/var/spool/slurmctld
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldPidFile=/run/slurmctld.pid
SlurmdPidFile=/run/slurmd.pid

AuthType=auth/munge
SlurmctldPort=6817
SlurmdPort=6818

# Kept deliberately simple for a reliable first boot. cgroup constraints are a later hardening step.
ProctrackType=proctrack/linuxproc
TaskPlugin=task/none
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
ReturnToService=2

SlurmctldTimeout=120
SlurmdTimeout=300

SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdLogFile=/var/log/slurm/slurmd.log

# ---- To add GPUs later: uncomment the next line, put Gres=gpu:N on the node line
# ---- in inventory, and drop a gres.conf on that node. No rebuild needed.
# GresTypes=gpu

# ---- Nodes (looped over the whole cluster; new inventory hosts appear here automatically) ----
{% for host in groups['cluster'] %}
NodeName={{ host }} NodeAddr={{ hostvars[host].node_addr }} CPUs={{ hostvars[host].slurm_cpus }} RealMemory={{ hostvars[host].slurm_realmem }}{% if hostvars[host].slurm_gres is defined %} Gres={{ hostvars[host].slurm_gres }}{% endif %} State=UNKNOWN
{% endfor %}

PartitionName=main Nodes=ALL Default=YES MaxTime=INFINITE State=UP
